{
  "name": "quizlo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "backup": "tsx --env-file=.env scripts/backup.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase-admin": "^14.5.0",
    "jsdom": "^27.0.0",
    "next": "^15.5.28",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "react-dropzone": "^14.3.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "description": "Polish quiz app with typed-answer, matching and map modes, built with Next.js, TypeScript and Firestore.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
