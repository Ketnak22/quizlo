# Firebase service account (Firebase console > Project settings > Service accounts).
# Project id, the "project_id" field of the downloaded JSON key.
FIREBASE_PROJECT_ID=
# Service account email, the "client_email" field of the JSON key.
FIREBASE_CLIENT_EMAIL=
# Private key, the "private_key" field of the JSON key. Keep it on one line, in double quotes, with literal \n.
FIREBASE_PRIVATE_KEY=

# Secret required to publish quizzes and maps. Leave it empty to run as a read-only demo.
ADMIN_TOKEN=
